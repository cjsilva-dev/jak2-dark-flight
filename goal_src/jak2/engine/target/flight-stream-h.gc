;;-*-Lisp-*-
(in-package goal)

;; name: flight-stream-h.gc (Jak 2 / Dark Flight)
;; Everything flight-stream.gc needs to know about this game, apart from the ground map
;; (flight-map.gc, generated). Keep flight-stream.gc itself identical to the one in the
;; jak3-true-flight repo.

(defconstant FS-SLOTS 6) ;; slots in *load-state* want

(defun fs-borrow-mode? ((info level-load-info))
  (= (-> info memory-mode) (load-buffer-mode borrow))
  )
(defun fs-alias-mode? ((info level-load-info))
  #f ;; Jak 2 has no alias levels
  )
(defun fs-master-level ((info level-load-info))
  (the-as symbol #f) ;; Jak 2 has no master levels
  )
(defun fs-wide-level? ((name symbol))
  "A level that spans a whole mapped area and must stay while Jak is anywhere in it. Haven's is
   ctywide; it is in the level set of nearly every city checkpoint, but not of all of them, so it
   can't be derived."
  (= name 'ctywide)
  )

(defun fs-city-mission? ()
  "A city mission level is wanted (its actors are the mission): leave the level list alone."
  (let ((m #f))
    (dotimes (i FS-SLOTS)
      (let ((nm (-> *load-state* want i name)))
        (if (or (= nm 'ctykora) (= nm 'ctyasha))
            (set! m #t)
            )
        )
      )
    m
    )
  )
