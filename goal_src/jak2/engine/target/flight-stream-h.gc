;;-*-Lisp-*-
(in-package goal)

;; name: flight-stream-h.gc (Jak 2 / Dark Flight)
;; Everything flight-stream.gc needs to know about this game. Keep flight-stream.gc itself identical
;; to the one in the jak3-true-flight repo.

(defconstant FS-SLOTS 6) ;; slots in *load-state* want and in a continue point's level set

;; a continue point's level set: Jak 2 stores a fixed array of 6, empty slots are #f
(defmacro fs-want-slots (c) 6)
(defun fs-want-named ((c continue-point))
  "How many levels this continue point's set actually names."
  (let ((n 0))
    (dotimes (i 6)
      (if (-> c want i name)
          (set! n (+ n 1))
          )
      )
    n
    )
  )

(defun fs-borrow-mode? ((info level-load-info))
  (= (-> info memory-mode) (load-buffer-mode borrow))
  )
(defun fs-alias-mode? ((info level-load-info))
  #f ;; Jak 2 has no alias levels
  )
(defun fs-edge-mode? ((info level-load-info))
  (or (= (-> info memory-mode) (load-buffer-mode small-edge))
      (= (-> info memory-mode) (load-buffer-mode small-center))
      )
  )
(defun fs-master-level ((info level-load-info))
  (the-as symbol #f) ;; Jak 2 has no master levels
  )

;; dev/cutscene levels whose continue points sit in the world: never used, never wanted
(define *fs-stream-exclude* '(ctyfence test-zone title intro introcst demo halfpipe skatepark
                              chartest dptest eitest miketest tatetest tobytest teststdc teststdd vistest woodstest andrew01 4aaron 4pal01))
;; areas that stream by position on their own: none in Jak 2
(define *fs-stream-skip-prefixes* '())

(defun fs-city-mission? ()
  "A city mission level is wanted (its actors are the mission): leave the level list alone."
  (let ((m #f))
    (dotimes (i FS-SLOTS)
      (let ((nm (-> *load-state* want i name)))
        (if (or (= nm 'ctykora) (= nm 'ctyasha))
            (set! m #t)
            )
        )
      )
    m
    )
  )
